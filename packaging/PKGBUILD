# About: builds Kickoff Nested from this repository's working tree (including
# uncommitted changes) and packages it for pacman: the applet plugin
# local.kickoffnested, the Kicker parts QML module kickoffnested.kickerparts,
# and a pacman hook that warns when an installed Plasma version differs from
# the upstream release in UPSTREAM_BASE the package was built from. The
# version comes from VERSION (see pkgver.sh). Plasma is required only from
# the base's minor version on, so system upgrades are never blocked.
# Usage: cd packaging && makepkg -si
#
# SPDX-FileCopyrightText: 2026 Ueda-Ichitaka
# SPDX-License-Identifier: MIT

pkgname=kickoff-nested
pkgver=1.0.0.r1862.g088a710
pkgrel=1
pkgdesc='Plasma Application Launcher (Kickoff) with Kicker-style nested subfolders'
arch=('x86_64')
license=('GPL-2.0-or-later' 'MIT')

_repo="$(realpath "${startdir}/..")"
_base="$(<"${_repo}/UPSTREAM_BASE")"
_plasma_minor="${_base#v}"
_plasma_minor="${_plasma_minor%.*}"

depends=(
  "libplasma>=${_plasma_minor}"
  "plasma-workspace>=${_plasma_minor}"
  'plasma5support'
  'kcmutils'
  'kconfig'
  'kcoreaddons'
  'kiconthemes'
  'kirigami'
  'kirigami-addons'
  'kitemmodels'
  'ksvg'
  'qt6-declarative'
)
makedepends=('cmake' 'extra-cmake-modules' 'ninja' 'git')

pkgver() {
  bash "${_repo}/packaging/pkgver.sh" "${_repo}"
}

build() {
  cmake -S "${_repo}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 "${_repo}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${_repo}/UPSTREAM_BASE" "${pkgdir}/usr/share/kickoff-nested/upstream-base"
  install -Dm755 "${_repo}/packaging/plasma-check.sh" "${pkgdir}/usr/lib/kickoff-nested/plasma-check"
  install -Dm644 "${_repo}/packaging/kickoff-nested-plasma-check.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/kickoff-nested-plasma-check.hook"
}
